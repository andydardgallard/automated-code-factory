{
  "mcpServers": {
    "chrome-devtools": {
      "command": "node",
      "args": [
        "{CHROME_DEVTOOLS_MCP_ENTRY}",
        "--isolated=true",
        "--headless=true",
        "--channel=stable",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--redact-network-headers=true"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1",
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      }
    }
  },
  "codeFactory": {
    "package": "chrome-devtools-mcp",
    "version": "1.11.0",
    "entryPlaceholder": "{CHROME_DEVTOOLS_MCP_ENTRY}"
  }
}
