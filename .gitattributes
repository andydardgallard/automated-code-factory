# Машиночитаемый слепок error-routing таблиц: тест test_error_router.py требует LF
# (детерминированный JSON, CRLF от core.autocrlf ломает побайтовую проверку).
.agents/skills/code-factory/references/error-patterns.default.json text eol=lf
# Windows-лаунчеры (.cmd/.ps1) должны быть CRLF при checkout независимо от core.autocrlf.
*.cmd text eol=crlf
*.ps1 text eol=crlf
# bash-скрипты (*.sh) — наоборот, LF при checkout на любой машине: bash-скрипт с CRLF ломается,
# а сам деплойер пишет start.sh именно с LF (побайтовая проверка в test_windows_scripts.py).
*.sh text eol=lf
