# Machine-readable snapshot of the error-routing tables: test_error_router.py requires LF
# (deterministic JSON; CRLF from core.autocrlf breaks the byte-level check).
.agents/skills/code-factory/references/error-patterns.default.json text eol=lf
# Windows launchers (.cmd/.ps1) must be CRLF at checkout regardless of core.autocrlf.
*.cmd text eol=crlf
*.ps1 text eol=crlf
# bash scripts (*.sh) — the opposite: LF at checkout on any machine, a bash script with CRLF breaks,
# and the deployer itself writes start.sh with LF (byte-level check in test_windows_scripts.py).
*.sh text eol=lf
