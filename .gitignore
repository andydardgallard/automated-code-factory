# Code Factory runtime state (never commit)
.code-factory/

# Machine-local Kimi Code MCP configuration: the managed chrome-devtools entry carries the
# ABSOLUTE path of the vendored package of THIS machine, so it is not shareable and the
# vendored package itself (installed by the deployer) is never committed.
.kimi-code/mcp.json
.kimi-code/vendor/

# Personal business task files (commit the .example.task.yaml template instead)
task.yaml

# Python
__pycache__/
*.pyc

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Secrets — never commit credentials / API keys
.env
.env.*
*.env
*.pem
*.key

# --- Code Factory (auto-added by prepare_factory.ps1) ---
.code-factory/
.kimi-code/mcp.json
.kimi-code/vendor/
__pycache__/
*.pyc
.env
.env.*
*.env
*.pem
*.key
task.yaml
start.cmd
start.sh

# --- Code Factory (auto-added by prepare_factory.ps1) ---
# NOTE: `.agents/` is deliberately NOT ignored here. This repository IS the factory, so its
# `.agents/` tree is SOURCE, not a deployment copy; ignoring it would let a new factory script be
# silently hidden from commits and from the tracked review inventory. A generated TARGET project's
# ignore file still gets `.agents/` from the deployer, where that tree is a deployment copy.
.code-factory/
.kimi-code/mcp.json
.kimi-code/vendor/
__pycache__/
*.pyc
.env
.env.*
*.env
*.pem
*.key
task.yaml
start.cmd
start.sh
